{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nurikabe",
    "compatibility_date": "2026-09-17",
    // no *.workers.dev URL and no per-version preview URLs; serve only from routes / custom domains
    "workers_dev": false,
    "preview_urls": false,
    "routes": [{ "pattern": "nurikabe.b-kuch.com", "custom_domain": true }],
    "observability": {
        "enabled": true
    },
    "assets": {
        // Vite's build output (npm run build)
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    }
}