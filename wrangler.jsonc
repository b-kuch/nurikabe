{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nurikabe",
    "compatibility_date": "2026-09-17",
    "observability": {
        "enabled": true
    },
    "assets": {
        // Vite's build output (npm run build)
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    }
}